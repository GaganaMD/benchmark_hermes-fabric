+def test_dry_run_write_does_not_create_file(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--dry-run", "write", "out.txt", "--content", "x"])
+    assert result.exit_code == 0
+    assert "would write out.txt" in result.output
+    assert not (tmp_path / "out.txt").exists()
