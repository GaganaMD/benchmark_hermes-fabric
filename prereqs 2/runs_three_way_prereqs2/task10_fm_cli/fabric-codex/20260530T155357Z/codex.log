+from __future__ import annotations
+
+import click
+
+from . import ops
+
+
+@click.group(context_settings={"help_option_names": ["-h", "--help"]})
+def cli() -> None:
+    """Manage files and tags."""
+
+
+@cli.command("list")
+@click.argument("root", type=click.Path(path_type=str))
+def list_command(root: str) -> None:
+    """Print files under ROOT."""
+    for path in ops.list_files(root):
+        click.echo(path)
+
+
+@cli.command("move")
+@click.argument("src", type=click.Path(path_type=str))
+@click.argument("dst", type=click.Path(path_type=str))
+def move_command(src: str, dst: str) -> None:
+    """Move SRC to DST and preserve tags."""
+    ops.move_file(src, dst)
+
+
+@cli.command("tag")
+@click.argument("path", type=click.Path(path_type=str))
+@click.argument("tag")
+def tag_command(path: str, tag: str) -> None:
+    """Add TAG to PATH."""
+    ops.add_tag(path, tag)
+
+
+@cli.command("search-by-tag")
+@click.argument("root", type=click.Path(path_type=str))
+@click.argument("tag")
+def search_by_tag_command(root: str, tag: str) -> None:
+    """Print files under ROOT that have TAG."""
+    for path in ops.search_by_tag(root, tag):
+        click.echo(path)
+
+
+if __name__ == "__main__":
+    cli()
+
