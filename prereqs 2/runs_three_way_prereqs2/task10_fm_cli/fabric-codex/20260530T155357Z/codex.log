+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from . import db
+
+
+def normalize_root(root: str | Path) -> Path:
+    return Path(root).expanduser().resolve()
+
+
+def relative_to_root(path: Path, root: Path) -> str:
+    return path.resolve().relative_to(root).as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    managed_root = normalize_root(root)
+    if not managed_root.exists():
+        raise FileNotFoundError(managed_root)
+    if not managed_root.is_dir():
+        raise NotADirectoryError(managed_root)
+
+    files: list[str] = []
+    for path in managed_root.rglob("*"):
+        if path.is_file() and path.name != ".fm.db":
+            files.append(path.relative_to(managed_root).as_posix())
+    return sorted(files)
+
+
+def move_file(src: str | Path, dst: str | Path) -> None:
+    source = Path(src).expanduser().resolve()
+    target = Path(dst).expanduser().resolve()
+    root = Path.cwd().resolve()
+    old_rel = relative_to_root(source, root)
+    new_rel = relative_to_root(target, root)
+
+    target.parent.mkdir(parents=True, exist_ok=True)
+    conn = db.connect(root, create=False)
+    moved = False
+    try:
+        if conn is not None:
+            conn.execute("BEGIN IMMEDIATE")
+        os.replace(source, target)
+        moved = True
+        if conn is not None:
+            db.update_path(conn, old_rel, new_rel)
+            conn.commit()
+    except Exception:
+        if conn is not None:
+            conn.rollback()
+        if moved:
+            os.replace(target, source)
+        raise
+    finally:
+        if conn is not None:
+            conn.close()
+
+
+def add_tag(path: str | Path, tag: str) -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+    root = Path.cwd().resolve()
+    target = Path(path).expanduser().resolve()
+    rel_path = relative_to_root(target, root)
+    db.add_tag(root, rel_path, tag)
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    managed_root = normalize_root(root)
+    matches = []
+    for rel_path in db.tagged_paths(managed_root, tag):
+        if (managed_root / rel_path).is_file():
+            matches.append(rel_path)
+    return matches
+
