new file mode 100644
index 0000000000000000000000000000000000000000..90b19d1fe9124ad49dd705d9e7f9110989d8b1e1
--- /dev/null
+++ b/tools/fm/db.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / ".fm.db"
+
+
+def connect(root: Path, *, create: bool = False) -> sqlite3.Connection | None:
+    path = db_path(root)
+    if not create and not path.exists():
+        return None
+
+    conn = sqlite3.connect(path)
+    conn.execute("PRAGMA foreign_keys = ON")
+    if create:
+        conn.executescript(SCHEMA)
+        conn.commit()
+    return conn
+
+
+def add_tag(root: Path, rel_path: str, tag: str) -> None:
+    conn = connect(root, create=True)
+    assert conn is not None
+    with conn:
+        cursor = conn.execute(
+            "INSERT OR IGNORE INTO files(path) VALUES (?)",
+            (rel_path,),
+        )
+        if cursor.lastrowid:
+            file_id = cursor.lastrowid
+        else:
+            file_id = conn.execute(
+                "SELECT id FROM files WHERE path = ?",
+                (rel_path,),
+            ).fetchone()[0]
+        conn.execute(
+            "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+            (file_id, tag),
+        )
+    conn.close()
+
+
+def tagged_paths(root: Path, tag: str) -> list[str]:
+    conn = connect(root, create=False)
+    if conn is None:
+        return []
+
+    rows = conn.execute(
+        """
+        SELECT files.path
+        FROM files
+        JOIN tags ON tags.file_id = files.id
+        WHERE tags.tag = ?
+        ORDER BY files.path
+        """,
+        (tag,),
+    ).fetchall()
+    conn.close()
+    return [row[0] for row in rows]
+
+
+def update_path(conn: sqlite3.Connection, old_rel_path: str, new_rel_path: str) -> None:
+    existing = conn.execute(
+        "SELECT id FROM files WHERE path = ?",
+        (old_rel_path,),
+    ).fetchone()
+    if existing is None:
+        return
+
+    replacement = conn.execute(
+        "SELECT id FROM files WHERE path = ?",
+        (new_rel_path,),
+    ).fetchone()
+    if replacement is not None:
+        replacement_id = replacement[0]
+        old_id = existing[0]
+        conn.execute(
+            """
+            INSERT OR IGNORE INTO tags(file_id, tag)
+            SELECT ?, tag FROM tags WHERE file_id = ?
+            """,
+            (replacement_id, old_id),
+        )
+        conn.execute("DELETE FROM files WHERE id = ?", (old_id,))
+        return
+
+    conn.execute(
+        "UPDATE files SET path = ? WHERE path = ?",
+        (new_rel_path, old_rel_path),
+    )
+
diff --git a/tools/fm/ops.py b/tools/fm/ops.py
new file mode 100644
index 0000000000000000000000000000000000000000..f206161c123e30cc0af28c7b9d34d17260b8064a
--- /dev/null
+++ b/tools/fm/ops.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from . import db
+
+
+def normalize_root(root: str | Path) -> Path:
+    return Path(root).expanduser().resolve()
+
+
+def relative_to_root(path: Path, root: Path) -> str:
+    return path.resolve().relative_to(root).as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    managed_root = normalize_root(root)
+    if not managed_root.exists():
+        raise FileNotFoundError(managed_root)
+    if not managed_root.is_dir():
+        raise NotADirectoryError(managed_root)
+
+    files: list[str] = []
+    for path in managed_root.rglob("*"):
+        if path.is_file() and path.name != ".fm.db":
+            files.append(path.relative_to(managed_root).as_posix())
+    return sorted(files)
+
+
+def move_file(src: str | Path, dst: str | Path) -> None:
+    source = Path(src).expanduser().resolve()
+    target = Path(dst).expanduser().resolve()
+    root = Path.cwd().resolve()
+    old_rel = relative_to_root(source, root)
+    new_rel = relative_to_root(target, root)
+
+    target.parent.mkdir(parents=True, exist_ok=True)
+    conn = db.connect(root, create=False)
+    moved = False
+    try:
+        if conn is not None:
+            conn.execute("BEGIN IMMEDIATE")
+        os.replace(source, target)
+        moved = True
+        if conn is not None:
+            db.update_path(conn, old_rel, new_rel)
+            conn.commit()
+    except Exception:
+        if conn is not None:
+            conn.rollback()
+        if moved:
+            os.replace(target, source)
+        raise
+    finally:
+        if conn is not None:
+            conn.close()
+
+
+def add_tag(path: str | Path, tag: str) -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+    root = Path.cwd().resolve()
+    target = Path(path).expanduser().resolve()
+    rel_path = relative_to_root(target, root)
+    db.add_tag(root, rel_path, tag)
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    managed_root = normalize_root(root)
+    matches = []
+    for rel_path in db.tagged_paths(managed_root, tag):
+        if (managed_root / rel_path).is_file():
+            matches.append(rel_path)
+    return matches
+
