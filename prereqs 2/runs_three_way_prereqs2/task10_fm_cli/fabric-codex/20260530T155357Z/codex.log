diff --git a/tools/fm/tests/test_fm.py b/tools/fm/tests/test_fm.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c97a792c13cf5746cedc4d8511877af58e742df
--- /dev/null
+++ b/tools/fm/tests/test_fm.py
@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+from click.testing import CliRunner
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
+
+from tools.fm.cli import cli
+
+
+def test_list_empty_directory_prints_nothing() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(cli, ["list", "."])
+
+    assert result.exit_code == 0
+    assert result.output == ""
+
+
+def test_list_prints_files_relative_to_root() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        runner.invoke(cli, ["tag", "alpha.txt", "ignored"])
+        result = runner.invoke(cli, ["list", "."])
+
+    assert result.exit_code == 0
+    assert result.output == ""
+
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as handle:
+            handle.write("readme")
+        result = runner.invoke(cli, ["list", "."])
+
+    assert result.exit_code == 0
+    assert result.output == "README.md\n"
+
+
+def test_tag_and_search_by_tag_prints_matching_file() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as handle:
+            handle.write("readme")
+        tag_result = runner.invoke(cli, ["tag", "README.md", "draft"])
+        search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"])
+
+    assert tag_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output == "README.md\n"
+
+
+def test_duplicate_tag_is_noop() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as handle:
+            handle.write("readme")
+        first = runner.invoke(cli, ["tag", "README.md", "draft"])
+        second = runner.invoke(cli, ["tag", "README.md", "draft"])
+        search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"])
+
+    assert first.exit_code == 0
+    assert second.exit_code == 0
+    assert search_result.output == "README.md\n"
+
+
+def test_move_preserves_tags() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as handle:
+            handle.write("readme")
+        runner.invoke(cli, ["tag", "README.md", "draft"])
+        move_result = runner.invoke(cli, ["move", "README.md", "NOTES.md"])
+        search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"])
+
+    assert move_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output == "NOTES.md\n"
+
+
+def test_help_shows_all_subcommands() -> None:
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--help"])
+
+    assert result.exit_code == 0
+    for command in ["list", "move", "tag", "search-by-tag"]:
+        assert command in result.output

