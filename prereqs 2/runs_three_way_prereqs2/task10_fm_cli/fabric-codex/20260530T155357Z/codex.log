+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / ".fm.db"
+
+
+def connect(root: Path, *, create: bool = False) -> sqlite3.Connection | None:
+    path = db_path(root)
+    if not create and not path.exists():
+        return None
+
+    conn = sqlite3.connect(path)
+    conn.execute("PRAGMA foreign_keys = ON")
+    if create:
+        conn.executescript(SCHEMA)
+        conn.commit()
+    return conn
+
+
+def add_tag(root: Path, rel_path: str, tag: str) -> None:
+    conn = connect(root, create=True)
+    assert conn is not None
+    with conn:
+        cursor = conn.execute(
+            "INSERT OR IGNORE INTO files(path) VALUES (?)",
+            (rel_path,),
+        )
+        if cursor.lastrowid:
+            file_id = cursor.lastrowid
+        else:
+            file_id = conn.execute(
+                "SELECT id FROM files WHERE path = ?",
+                (rel_path,),
+            ).fetchone()[0]
+        conn.execute(
+            "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+            (file_id, tag),
+        )
+    conn.close()
+
+
+def tagged_paths(root: Path, tag: str) -> list[str]:
+    conn = connect(root, create=False)
+    if conn is None:
+        return []
+
+    rows = conn.execute(
+        """
+        SELECT files.path
+        FROM files
+        JOIN tags ON tags.file_id = files.id
+        WHERE tags.tag = ?
+        ORDER BY files.path
+        """,
+        (tag,),
+    ).fetchall()
+    conn.close()
+    return [row[0] for row in rows]
+
+
+def update_path(conn: sqlite3.Connection, old_rel_path: str, new_rel_path: str) -> None:
+    existing = conn.execute(
+        "SELECT id FROM files WHERE path = ?",
+        (old_rel_path,),
+    ).fetchone()
+    if existing is None:
+        return
+
+    replacement = conn.execute(
+        "SELECT id FROM files WHERE path = ?",
+        (new_rel_path,),
+    ).fetchone()
+    if replacement is not None:
+        replacement_id = replacement[0]
+        old_id = existing[0]
+        conn.execute(
+            """
+            INSERT OR IGNORE INTO tags(file_id, tag)
+            SELECT ?, tag FROM tags WHERE file_id = ?
+            """,
+            (replacement_id, old_id),
+        )
+        conn.execute("DELETE FROM files WHERE id = ?", (old_id,))
+        return
+
+    conn.execute(
+        "UPDATE files SET path = ? WHERE path = ?",
+        (new_rel_path, old_rel_path),
+    )
+
