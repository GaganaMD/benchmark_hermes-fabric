diff --git a/tests/test_workers.py b/tests/test_workers.py
index dbd9cdfe55f96e416466d01dd16d607b363f57ca..9886a4b103d3d93c752db160eaf3f2a980f5c37f
--- a/tests/test_workers.py
+++ b/tests/test_workers.py
@@ -1,6 +1,75 @@
 from src.workers import dispatch
 
+def setup_function():
+    dispatch._results.clear()
+
 def test_run_task_happy_path(monkeypatch):
     monkeypatch.setattr(dispatch, "fetch_from_broker", lambda tid: {"n": 21})
     result = dispatch.run_task(lambda p: p["n"] * 2, "t1")
     assert result == 42
+
+def test_retries_on_broker_error(monkeypatch):
+    attempts = []
+    delays = []
+
+    def flaky_fetch(tid):
+        attempts.append(tid)
+        if len(attempts) < 3:
+            raise dispatch.BrokerError("temporary broker failure")
+        return {"n": 21}
+
+    monkeypatch.setattr(dispatch, "fetch_from_broker", flaky_fetch)
+
+    result = dispatch.run_task(
+        lambda p: p["n"] * 2,
+        "t-retry",
+        sleep=delays.append,
+    )
+
+    assert result == 42
+    assert attempts == ["t-retry", "t-retry", "t-retry"]
+    assert delays == [0.1, 0.2]
+
+def test_gives_up_after_max_retries(monkeypatch):
+    attempts = []
+    delays = []
+
+    def always_fails(tid):
+        attempts.append(tid)
+        raise dispatch.BrokerError("broker unavailable")
+
+    monkeypatch.setattr(dispatch, "fetch_from_broker", always_fails)
+
+    try:
+        dispatch.run_task(
+            lambda p: p["n"] * 2,
+            "t-fail",
+            max_retries=2,
+            sleep=delays.append,
+        )
+    except dispatch.BrokerError:
+        pass
+    else:
+        raise AssertionError("expected BrokerError")
+
+    assert attempts == ["t-fail", "t-fail", "t-fail"]
+    assert delays == [0.1, 0.2]
+
+def test_idempotent(monkeypatch):
+    fetches = []
+    handled = []
+
+    def fetch(tid):
+        fetches.append(tid)
+        return {"n": 21}
+
+    def handler(payload):
+        handled.append(payload)
+        return payload["n"] * 2
+
+    monkeypatch.setattr(dispatch, "fetch_from_broker", fetch)
+
+    assert dispatch.run_task(handler, "t-idempotent") == 42
+    assert dispatch.run_task(handler, "t-idempotent") == 42
+    assert fetches == ["t-idempotent"]
+    assert handled == [{"n": 21}]

