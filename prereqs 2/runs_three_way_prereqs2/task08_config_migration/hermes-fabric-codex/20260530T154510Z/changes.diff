+
+def _load_toml(path: Path) -> dict:
+    with path.open("rb") as f:
+        return tomllib.load(f)
+
+
+def load_config(path: str = "config.ini") -> dict:
+    requested = Path(path)
+    toml_path = requested.with_name("config.toml") if requested.name == "config.ini" else requested
+
+    if toml_path.suffix == ".toml" and toml_path.exists():
+        return _load_toml(toml_path)
+
+    if requested.exists():
+        return _load_ini(requested)
+
+    raise FileNotFoundError(path)
