+import pytest
+
+from src.config import load_config
+
+
+def test_loads_toml_when_only_config_toml_exists(tmp_path, monkeypatch):
+    toml = tmp_path / "config.toml"
+    toml.write_text(
+        '[server]\nhost = "0.0.0.0"\nport = 8080\n'
+        '[db]\nurl = "sqlite:///app.db"\npool_size = 5\n'
+    )
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg == {
+        "server": {"host": "0.0.0.0", "port": 8080},
+        "db": {"url": "sqlite:///app.db", "pool_size": 5},
+    }
+
+
+def test_ini_only_fallback_emits_deprecation_warning(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n")
+    monkeypatch.chdir(tmp_path)
+
+    with pytest.warns(DeprecationWarning, match="config.toml"):
+        cfg = load_config()
+
+    assert cfg["server"]["host"] == "1.2.3.4"
+    assert cfg["server"]["port"] == "9000"
+
+
+def test_prefers_toml_when_both_config_files_exist(tmp_path, monkeypatch):
+    (tmp_path / "config.ini").write_text("[server]\nhost = ini-host\nport = 9000\n")
+    (tmp_path / "config.toml").write_text(
+        '[server]\nhost = "toml-host"\nport = 8080\n'
+    )
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg["server"]["host"] == "toml-host"
+    assert cfg["server"]["port"] == 8080
