+"""Configuration loader with TOML-first migration and INI fallback."""
 import configparser
+import warnings
 from pathlib import Path
 
-def load_config(path: str = "config.ini") -> dict:
+try:
+    import tomllib
+except ModuleNotFoundError:  # pragma: no cover
+    import tomli as tomllib
+
+
+def _load_toml(path: Path) -> dict:
+    with path.open("rb") as f:
+        data = tomllib.load(f)
+    if not isinstance(data, dict):
+        raise ValueError(f"Top-level TOML document must be a table: {path}")
+    return data
+
+
+def _load_ini(path: Path) -> dict:
     parser = configparser.ConfigParser()
-    if not Path(path).exists():
-        raise FileNotFoundError(path)
     parser.read(path)
     return {section: dict(parser[section]) for section in parser.sections()}
+
+
+def load_config(path: str = "config.toml") -> dict:
+    requested = Path(path)
+
+    # Default behavior during migration: TOML first, INI fallback with warning.
+    if path == "config.toml":
+        if requested.exists():
+            return _load_toml(requested)
+
+        legacy = Path("config.ini")
+        if legacy.exists():
+            warnings.warn(
+                "config.ini is deprecated and will be removed in a future release; "
+                "please migrate to config.toml",
+                DeprecationWarning,
+                stacklevel=2,
+            )
+            return _load_ini(legacy)
+
+        raise FileNotFoundError("config.toml")
+
+    if not requested.exists():
+        raise FileNotFoundError(path)
+
+    if requested.suffix.lower() == ".toml":
+        return _load_toml(requested)
+
+    if requested.suffix.lower() == ".ini":
+        warnings.warn(
+            "Loading INI config is deprecated; please migrate to TOML",
+            DeprecationWarning,
+            stacklevel=2,
+        )
+        return _load_ini(requested)
+
+    raise ValueError(f"Unsupported config format: {requested.suffix}")
