+def test_loads_toml_by_default(tmp_path, monkeypatch):
+    toml = tmp_path / "config.toml"
+    toml.write_text('[server]\nhost = "1.2.3.4"\nport = 9000\n', encoding="utf-8")
+
     monkeypatch.chdir(tmp_path)
     cfg = load_config()
+
+    assert cfg["server"]["host"] == "1.2.3.4"
+    assert cfg["server"]["port"] == 9000
+
+
+def test_falls_back_to_ini_with_deprecation_warning(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n", encoding="utf-8")
+
+    monkeypatch.chdir(tmp_path)
+    with pytest.deprecated_call(match="config.ini is deprecated"):
+        cfg = load_config()
+
     assert cfg["server"]["host"] == "1.2.3.4"
     assert cfg["server"]["port"] == "9000"
+
+
+def test_toml_precedence_over_ini(tmp_path, monkeypatch):
+    toml = tmp_path / "config.toml"
+    ini = tmp_path / "config.ini"
+
+    toml.write_text('[server]\nhost = "10.0.0.1"\nport = 8080\n', encoding="utf-8")
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n", encoding="utf-8")
+
+    monkeypatch.chdir(tmp_path)
+    cfg = load_config()
+
