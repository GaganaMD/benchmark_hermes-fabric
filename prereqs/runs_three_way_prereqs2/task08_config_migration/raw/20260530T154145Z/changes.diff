+
+def load_config(path: str = "config.ini") -> dict:
+    config_path = Path(path)
+
+    if path == "config.ini":
+        toml_path = config_path.with_suffix(".toml")
+        if toml_path.exists():
+            return _load_toml(toml_path)
+        if config_path.exists():
+            warnings.warn(
+                "config.ini loading is deprecated; migrate to config.toml",
+                DeprecationWarning,
+                stacklevel=2,
+            )
+            return _load_ini(config_path)
+        raise FileNotFoundError(toml_path)
+
+    if not config_path.exists():
+        raise FileNotFoundError(path)
+    if config_path.suffix == ".toml":
+        return _load_toml(config_path)
+    if config_path.suffix == ".ini":
+        warnings.warn(
+            "config.ini loading is deprecated; migrate to config.toml",
+            DeprecationWarning,
+            stacklevel=2,
+        )
+        return _load_ini(config_path)
