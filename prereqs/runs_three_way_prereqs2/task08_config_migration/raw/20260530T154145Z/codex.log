diff --git a/tests/test_config_toml.py b/tests/test_config_toml.py
new file mode 100644
index 0000000000000000000000000000000000000000..bc62280452ec169c330a64239b644a18d602f24a
--- /dev/null
+++ b/tests/test_config_toml.py
@@ -0,0 +1,44 @@
+import pytest
+
+from src.config import load_config
+
+
+def test_loads_toml(tmp_path, monkeypatch):
+    toml = tmp_path / "config.toml"
+    toml.write_text(
+        '[server]\nhost = "0.0.0.0"\nport = 8080\n\n'
+        '[db]\nurl = "sqlite:///app.db"\npool_size = 5\n'
+    )
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg["server"]["host"] == "0.0.0.0"
+    assert cfg["server"]["port"] == 8080
+    assert cfg["db"]["url"] == "sqlite:///app.db"
+    assert cfg["db"]["pool_size"] == 5
+
+
+def test_loads_ini_with_deprecation_warning(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n")
+    monkeypatch.chdir(tmp_path)
+
+    with pytest.warns(DeprecationWarning, match="config.toml"):
+        cfg = load_config()
+
+    assert cfg["server"]["host"] == "1.2.3.4"
+    assert cfg["server"]["port"] == "9000"
+
+
+def test_prefers_toml_when_toml_and_ini_are_present(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n")
+    toml = tmp_path / "config.toml"
+    toml.write_text('[server]\nhost = "0.0.0.0"\nport = 8080\n')
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg["server"]["host"] == "0.0.0.0"
+    assert cfg["server"]["port"] == 8080

