@@ -0,0 +1,39 @@
+import pytest
+
+from src.config import load_config
+
+
+def test_loads_toml_by_default(tmp_path, monkeypatch):
+    toml = tmp_path / "config.toml"
+    toml.write_text('[server]\nhost = "1.2.3.4"\nport = 9000\n')
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg["server"]["host"] == "1.2.3.4"
+    assert cfg["server"]["port"] == 9000
+
+
+def test_prefers_toml_when_ini_is_also_present(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = ini.example\nport = 9000\n")
+    toml = tmp_path / "config.toml"
+    toml.write_text('[server]\nhost = "toml.example"\nport = 9001\n')
+    monkeypatch.chdir(tmp_path)
+
+    cfg = load_config()
+
+    assert cfg["server"]["host"] == "toml.example"
+    assert cfg["server"]["port"] == 9001
+
+
+def test_ini_fallback_warns_about_toml_migration(tmp_path, monkeypatch):
+    ini = tmp_path / "config.ini"
+    ini.write_text("[server]\nhost = 1.2.3.4\nport = 9000\n")
+    monkeypatch.chdir(tmp_path)
+
+    with pytest.warns(DeprecationWarning, match="config.toml"):
+        cfg = load_config()
+
+    assert cfg["server"]["host"] == "1.2.3.4"
+    assert cfg["server"]["port"] == "9000"

