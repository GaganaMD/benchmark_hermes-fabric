+"""Small file-management CLI package."""
+
/dev/null → b/tools/fm/db.py
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+
+DB_NAME = ".fm.db"
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+def connect(root: Path, *, create: bool = False) -> sqlite3.Connection | None:
+    path = db_path(root)
+    if not create and not path.exists():
+        return None
+    conn = sqlite3.connect(path)
+    conn.execute("PRAGMA foreign_keys = ON")
+    if create:
+        conn.executescript(SCHEMA)
+        conn.commit()
+    return conn
+
+
+def add_tag(root: Path, relative_path: str, tag: str) -> None:
+    with connect(root, create=True) as conn:
+        cur = conn.execute(
+            "INSERT OR IGNORE INTO files(path) VALUES (?)",
+            (relative_path,),
+        )
+        if cur.lastrowid:
+            file_id = cur.lastrowid
+        else:
+            file_id = conn.execute(
+                "SELECT id FROM files WHERE path = ?",
+                (relative_path,),
+            ).fetchone()[0]
+        conn.execute(
+            "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+            (file_id, tag),
+        )
+
+
+def paths_for_tag(root: Path, tag: str) -> list[str]:
+    conn = connect(root, create=False)
+    if conn is None:
+        return []
+    with conn:
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    conn.close()
+    return [row[0] for row in rows]
+
+
