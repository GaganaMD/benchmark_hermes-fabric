@@ -7,3 +7,28 @@ def test_write_creates_file(tmp_path, monkeypatch):
     result = runner.invoke(cli, ["write", "out.txt", "--content", "hi"])
     assert result.exit_code == 0
     assert (tmp_path / "out.txt").read_text() == "hi"
+
+
+def test_dry_run_write_prints_intended_action_without_creating_file(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    runner = CliRunner()
+
+    result = runner.invoke(cli, ["--dry-run", "write", "out.txt", "--content", "hi"])
+
+    assert result.exit_code == 0
+    assert "would write out.txt" in result.output
+    assert not (tmp_path / "out.txt").exists()
+
+
+def test_dry_run_rename_prints_intended_action_without_renaming_file(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    source = tmp_path / "out.txt"
+    source.write_text("hi")
+    runner = CliRunner()
+
+    result = runner.invoke(cli, ["--dry-run", "rename", "out.txt"])
+
+    assert result.exit_code == 0
+    assert "would rename out.txt -> out.txt.bak" in result.output
+    assert source.exists()
+    assert not (tmp_path / "out.txt.bak").exists()
