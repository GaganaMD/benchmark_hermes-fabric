+from __future__ import annotations
+
+import sqlite3
+
+from click.testing import CliRunner
+
+from tools.fm.cli import cli
+
+
+def test_list_prints_files_relative_to_root(tmp_path):
+    (tmp_path / "a.txt").write_text("a")
+    (tmp_path / "nested").mkdir()
+    (tmp_path / "nested" / "b.txt").write_text("b")
+
+    result = CliRunner().invoke(cli, ["list", str(tmp_path)])
+
+    assert result.exit_code == 0
+    assert result.output.splitlines() == ["a.txt", "nested/b.txt"]
+
+
+def test_list_empty_dir_prints_nothing(tmp_path):
+    result = CliRunner().invoke(cli, ["list", str(tmp_path)])
+
+    assert result.exit_code == 0
+    assert result.output == ""
+    assert not (tmp_path / ".fm.db").exists()
+
+
+def test_tag_and_search_by_tag_round_trip(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "README.md").write_text("draft")
+
+    tag_result = CliRunner().invoke(cli, ["tag", "README.md", "draft"])
+    search_result = CliRunner().invoke(cli, ["search-by-tag", ".", "draft"])
+
+    assert tag_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output == "README.md\n"
+
+
+def test_tag_is_idempotent(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "README.md").write_text("draft")
+    runner = CliRunner()
+
+    assert runner.invoke(cli, ["tag", "README.md", "draft"]).exit_code == 0
+    assert runner.invoke(cli, ["tag", "README.md", "draft"]).exit_code == 0
+
+    with sqlite3.connect(tmp_path / ".fm.db") as conn:
+        count = conn.execute("SELECT COUNT(*) FROM tags").fetchone()[0]
+    assert count == 1
+
+
+def test_move_updates_tagged_path(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "README.md").write_text("draft")
+    runner = CliRunner()
+
+    assert runner.invoke(cli, ["tag", "README.md", "draft"]).exit_code == 0
+    move_result = runner.invoke(cli, ["move", "README.md", "NOTES.md"])
+    search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"])
+
+    assert move_result.exit_code == 0
+    assert not (tmp_path / "README.md").exists()
+    assert (tmp_path / "NOTES.md").read_text() == "draft"
+    assert search_result.exit_code == 0
+    assert search_result.output == "NOTES.md\n"
+
+
+def test_help_shows_all_subcommands():
+    result = CliRunner().invoke(cli, ["--help"])
+
+    assert result.exit_code == 0
+    assert "list" in result.output
+    assert "move" in result.output
+    assert "tag" in result.output
+    assert "search-by-tag" in result.output
+

