@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+from . import db
+
+
+def resolve_root(root: str | Path) -> Path:
+    return Path(root).resolve()
+
+
+def relative_to_root(path: str | Path, root: Path) -> str:
+    resolved = Path(path).resolve()
+    try:
+        relative = resolved.relative_to(root)
+    except ValueError as exc:
+        raise ValueError(f"{resolved} is outside managed root {root}") from exc
+    return relative.as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    resolved_root = resolve_root(root)
+    if not resolved_root.exists():
+        raise FileNotFoundError(resolved_root)
+    if not resolved_root.is_dir():
+        raise NotADirectoryError(resolved_root)
+
+    paths: list[str] = []
+    for path in resolved_root.rglob("*"):
+        if path.is_file() and path.name != db.DB_NAME:
+            paths.append(path.relative_to(resolved_root).as_posix())
+    return sorted(paths)
+
+
+def tag_file(path: str | Path, tag: str, root: str | Path = ".") -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+
+    resolved_root = resolve_root(root)
+    relative_path = relative_to_root(path, resolved_root)
+    file_path = resolved_root / relative_path
+    if not file_path.is_file():
+        raise FileNotFoundError(file_path)
+
+    db.add_tag(resolved_root, relative_path, tag)
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    resolved_root = resolve_root(root)
+    if not resolved_root.exists():
+        raise FileNotFoundError(resolved_root)
+    if not resolved_root.is_dir():
+        raise NotADirectoryError(resolved_root)
+    return [
+        relative_path
+        for relative_path in db.paths_for_tag(resolved_root, tag)
+        if (resolved_root / relative_path).is_file()
+    ]
+
+
+def move_file(src: str | Path, dst: str | Path, root: str | Path = ".") -> None:
+    resolved_root = resolve_root(root)
+    old_relative_path = relative_to_root(src, resolved_root)
+    new_relative_path = relative_to_root(dst, resolved_root)
+    src_path = resolved_root / old_relative_path
+    dst_path = resolved_root / new_relative_path
+
+    if not src_path.is_file():
+        raise FileNotFoundError(src_path)
+    if dst_path.exists():
+        raise FileExistsError(dst_path)
+    if not dst_path.parent.exists():
+        raise FileNotFoundError(dst_path.parent)
+
+    shutil.move(str(src_path), str(dst_path))
+    try:
+        db.move_path(resolved_root, old_relative_path, new_relative_path)
+    except Exception:
+        shutil.move(str(dst_path), str(src_path))
+        raise
+
