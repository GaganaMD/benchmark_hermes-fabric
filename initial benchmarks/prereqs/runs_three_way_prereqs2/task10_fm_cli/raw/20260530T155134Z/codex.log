@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+
+DB_NAME = ".fm.db"
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+@contextmanager
+def connect(root: Path) -> Iterator[sqlite3.Connection]:
+    conn = sqlite3.connect(db_path(root))
+    conn.execute("PRAGMA foreign_keys = ON")
+    conn.executescript(SCHEMA)
+    try:
+        yield conn
+    finally:
+        conn.close()
+
+
+def add_tag(root: Path, relative_path: str, tag: str) -> None:
+    with connect(root) as conn:
+        with conn:
+            cursor = conn.execute(
+                "INSERT OR IGNORE INTO files (path) VALUES (?)",
+                (relative_path,),
+            )
+            if cursor.lastrowid:
+                file_id = cursor.lastrowid
+            else:
+                file_id = conn.execute(
+                    "SELECT id FROM files WHERE path = ?",
+                    (relative_path,),
+                ).fetchone()[0]
+
+            conn.execute(
+                "INSERT OR IGNORE INTO tags (file_id, tag) VALUES (?, ?)",
+                (file_id, tag),
+            )
+
+
+def paths_for_tag(root: Path, tag: str) -> list[str]:
+    path = db_path(root)
+    if not path.exists():
+        return []
+
+    with connect(root) as conn:
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    return [row[0] for row in rows]
+
+
+def move_path(root: Path, old_relative_path: str, new_relative_path: str) -> None:
+    path = db_path(root)
+    if not path.exists():
+        return
+
+    with connect(root) as conn:
+        with conn:
+            conn.execute(
+                "UPDATE files SET path = ? WHERE path = ?",
+                (new_relative_path, old_relative_path),
+            )
+
diff --git a/tools/fm/ops.py b/tools/fm/ops.py
new file mode 100644
index 0000000000000000000000000000000000000000..03a589becc20ac2c330e74b07c932e7150aa2f3f
--- /dev/null
+++ b/tools/fm/ops.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+from . import db
+
+
+def resolve_root(root: str | Path) -> Path:
+    return Path(root).resolve()
+
+
+def relative_to_root(path: str | Path, root: Path) -> str:
+    resolved = Path(path).resolve()
+    try:
+        relative = resolved.relative_to(root)
+    except ValueError as exc:
+        raise ValueError(f"{resolved} is outside managed root {root}") from exc
+    return relative.as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    resolved_root = resolve_root(root)
+    if not resolved_root.exists():
+        raise FileNotFoundError(resolved_root)
+    if not resolved_root.is_dir():
+        raise NotADirectoryError(resolved_root)
+
+    paths: list[str] = []
+    for path in resolved_root.rglob("*"):
+        if path.is_file() and path.name != db.DB_NAME:
+            paths.append(path.relative_to(resolved_root).as_posix())
+    return sorted(paths)
+
+
+def tag_file(path: str | Path, tag: str, root: str | Path = ".") -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+
+    resolved_root = resolve_root(root)
+    relative_path = relative_to_root(path, resolved_root)
+    file_path = resolved_root / relative_path
+    if not file_path.is_file():
+        raise FileNotFoundError(file_path)
+
+    db.add_tag(resolved_root, relative_path, tag)
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    resolved_root = resolve_root(root)
+    if not resolved_root.exists():
+        raise FileNotFoundError(resolved_root)
+    if not resolved_root.is_dir():
+        raise NotADirectoryError(resolved_root)
+    return [
+        relative_path
+        for relative_path in db.paths_for_tag(resolved_root, tag)
+        if (resolved_root / relative_path).is_file()
+    ]
+
+
+def move_file(src: str | Path, dst: str | Path, root: str | Path = ".") -> None:
+    resolved_root = resolve_root(root)
+    old_relative_path = relative_to_root(src, resolved_root)
+    new_relative_path = relative_to_root(dst, resolved_root)
+    src_path = resolved_root / old_relative_path
+    dst_path = resolved_root / new_relative_path
+
+    if not src_path.is_file():
+        raise FileNotFoundError(src_path)
+    if dst_path.exists():
+        raise FileExistsError(dst_path)
+    if not dst_path.parent.exists():
+        raise FileNotFoundError(dst_path.parent)
+
+    shutil.move(str(src_path), str(dst_path))
+    try:
+        db.move_path(resolved_root, old_relative_path, new_relative_path)
+    except Exception:
+        shutil.move(str(dst_path), str(src_path))
+        raise
+
