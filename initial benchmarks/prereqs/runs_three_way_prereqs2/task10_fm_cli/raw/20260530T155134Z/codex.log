diff --git a/tools/fm/cli.py b/tools/fm/cli.py
new file mode 100644
index 0000000000000000000000000000000000000000..3cb94f09bc53344d10bf8c0f82d777638767fb79
--- /dev/null
+++ b/tools/fm/cli.py
@@ -0,0 +1,50 @@
+from __future__ import annotations
+
+from pathlib import Path
+
+import click
+
+from . import ops
+
+
+@click.group()
+def cli() -> None:
+    """Manage files and tags under a local root."""
+
+
+@cli.command("list")
+@click.argument("root", type=click.Path(path_type=Path))
+def list_command(root: Path) -> None:
+    """Print files under ROOT, recursively."""
+    for relative_path in ops.list_files(root):
+        click.echo(relative_path)
+
+
+@cli.command("move")
+@click.argument("src", type=click.Path(path_type=Path))
+@click.argument("dst", type=click.Path(path_type=Path))
+def move_command(src: Path, dst: Path) -> None:
+    """Move SRC to DST and preserve tags."""
+    ops.move_file(src, dst)
+
+
+@cli.command("tag")
+@click.argument("path", type=click.Path(path_type=Path))
+@click.argument("tag")
+def tag_command(path: Path, tag: str) -> None:
+    """Attach TAG to PATH."""
+    ops.tag_file(path, tag)
+
+
+@cli.command("search-by-tag")
+@click.argument("root", type=click.Path(path_type=Path))
+@click.argument("tag")
+def search_by_tag_command(root: Path, tag: str) -> None:
+    """Print files under ROOT that have TAG."""
+    for relative_path in ops.search_by_tag(root, tag):
+        click.echo(relative_path)
+
+
+if __name__ == "__main__":
+    cli()
+
diff --git a/tools/fm/db.py b/tools/fm/db.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c9d40cf9f4b22eec270e5379131384d2bc92197
--- /dev/null
+++ b/tools/fm/db.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+
+DB_NAME = ".fm.db"
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+@contextmanager
+def connect(root: Path) -> Iterator[sqlite3.Connection]:
+    conn = sqlite3.connect(db_path(root))
+    conn.execute("PRAGMA foreign_keys = ON")
+    conn.executescript(SCHEMA)
+    try:
+        yield conn
+    finally:
+        conn.close()
+
+
+def add_tag(root: Path, relative_path: str, tag: str) -> None:
+    with connect(root) as conn:
+        with conn:
+            cursor = conn.execute(
+                "INSERT OR IGNORE INTO files (path) VALUES (?)",
+                (relative_path,),
+            )
+            if cursor.lastrowid:
+                file_id = cursor.lastrowid
+            else:
+                file_id = conn.execute(
+                    "SELECT id FROM files WHERE path = ?",
+                    (relative_path,),
+                ).fetchone()[0]
+
+            conn.execute(
+                "INSERT OR IGNORE INTO tags (file_id, tag) VALUES (?, ?)",
+                (file_id, tag),
+            )
+
+
+def paths_for_tag(root: Path, tag: str) -> list[str]:
+    path = db_path(root)
+    if not path.exists():
+        return []
+
+    with connect(root) as conn:
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    return [row[0] for row in rows]
+
+
+def move_path(root: Path, old_relative_path: str, new_relative_path: str) -> None:
+    path = db_path(root)
+    if not path.exists():
+        return
+
+    with connect(root) as conn:
+        with conn:
+            conn.execute(
+                "UPDATE files SET path = ? WHERE path = ?",
+                (new_relative_path, old_relative_path),
+            )
+
