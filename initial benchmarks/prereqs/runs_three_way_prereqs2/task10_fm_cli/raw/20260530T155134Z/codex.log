+from __future__ import annotations
+
+from pathlib import Path
+
+import click
+
+from . import ops
+
+
+@click.group()
+def cli() -> None:
+    """Manage files and tags under a local root."""
+
+
+@cli.command("list")
+@click.argument("root", type=click.Path(path_type=Path))
+def list_command(root: Path) -> None:
+    """Print files under ROOT, recursively."""
+    for relative_path in ops.list_files(root):
+        click.echo(relative_path)
+
+
+@cli.command("move")
+@click.argument("src", type=click.Path(path_type=Path))
+@click.argument("dst", type=click.Path(path_type=Path))
+def move_command(src: Path, dst: Path) -> None:
+    """Move SRC to DST and preserve tags."""
+    ops.move_file(src, dst)
+
+
+@cli.command("tag")
+@click.argument("path", type=click.Path(path_type=Path))
+@click.argument("tag")
+def tag_command(path: Path, tag: str) -> None:
+    """Attach TAG to PATH."""
+    ops.tag_file(path, tag)
+
+
+@cli.command("search-by-tag")
+@click.argument("root", type=click.Path(path_type=Path))
+@click.argument("tag")
+def search_by_tag_command(root: Path, tag: str) -> None:
+    """Print files under ROOT that have TAG."""
+    for relative_path in ops.search_by_tag(root, tag):
+        click.echo(relative_path)
+
+
+if __name__ == "__main__":
+    cli()
+
