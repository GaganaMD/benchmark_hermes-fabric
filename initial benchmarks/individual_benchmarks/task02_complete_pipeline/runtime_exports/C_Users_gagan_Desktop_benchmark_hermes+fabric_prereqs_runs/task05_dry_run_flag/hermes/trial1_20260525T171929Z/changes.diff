+def test_dry_run_write_does_not_create_file(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    runner = CliRunner()
+    result = runner.invoke(
+        cli,
+        ["--dry-run", "write", "out.txt", "--content", "hi"],
+    )
+
+    assert result.exit_code == 0
+    assert "dry-run: would write out.txt" in result.output
