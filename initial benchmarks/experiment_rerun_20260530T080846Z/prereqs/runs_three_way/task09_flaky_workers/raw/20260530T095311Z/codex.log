diff --git a/tests/test_workers.py b/tests/test_workers.py
index dbd9cdfe55f96e416466d01dd16d607b363f57ca..9a4e95353236b35c250e61b84f3301dd0484a2f1
--- a/tests/test_workers.py
+++ b/tests/test_workers.py
@@ -1,6 +1,77 @@
 from src.workers import dispatch
 
+
+def setup_function():
+    dispatch._results.clear()
+
+
 def test_run_task_happy_path(monkeypatch):
     monkeypatch.setattr(dispatch, "fetch_from_broker", lambda tid: {"n": 21})
     result = dispatch.run_task(lambda p: p["n"] * 2, "t1")
     assert result == 42
+
+
+def test_retries_on_broker_error(monkeypatch):
+    attempts = []
+    sleeps = []
+
+    def flaky_fetch(task_id):
+        attempts.append(task_id)
+        if len(attempts) < 3:
+            raise dispatch.BrokerError("temporary broker outage")
+        return {"n": 21}
+
+    monkeypatch.setattr(dispatch, "fetch_from_broker", flaky_fetch)
+
+    result = dispatch.run_task(
+        lambda p: p["n"] * 2,
+        "t-retry",
+        max_retries=3,
+        sleep=sleeps.append,
+    )
+
+    assert result == 42
+    assert attempts == ["t-retry", "t-retry", "t-retry"]
+    assert sleeps == [0.1, 0.2]
+
+
+def test_gives_up_after_max_retries(monkeypatch):
+    attempts = []
+    sleeps = []
+
+    def failing_fetch(task_id):
+        attempts.append(task_id)
+        raise dispatch.BrokerError("broker unavailable")
+
+    monkeypatch.setattr(dispatch, "fetch_from_broker", failing_fetch)
+
+    try:
+        dispatch.run_task(
+            lambda p: p["n"] * 2,
+            "t-fail",
+            max_retries=3,
+            sleep=sleeps.append,
+        )
+    except dispatch.BrokerError:
+        pass
+    else:
+        raise AssertionError("BrokerError was not raised")
+
+    assert attempts == ["t-fail", "t-fail", "t-fail", "t-fail"]
+    assert sleeps == [0.1, 0.2, 0.4]
+
+
+def test_idempotent(monkeypatch):
+    calls = []
+    monkeypatch.setattr(dispatch, "fetch_from_broker", lambda tid: {"n": 21})
+
+    def handler(payload):
+        calls.append(payload)
+        return payload["n"] * 2
+
+    first = dispatch.run_task(handler, "t-idempotent")
+    second = dispatch.run_task(handler, "t-idempotent")
+
+    assert first == 42
+    assert second == 42
+    assert calls == [{"n": 21}]

