new file mode 100644
index 0000000000000000000000000000000000000000..20cc5aa667f113870a9bed528ac800dea798e150
--- /dev/null
+++ b/tools/fm/tests/test_fm.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+from click.testing import CliRunner
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
+
+from tools.fm.cli import cli
+
+
+def invoke(runner: CliRunner, *args: str):
+    return runner.invoke(cli, list(args))
+
+
+def test_list_empty_dir_prints_nothing() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = invoke(runner, "list", ".")
+
+    assert result.exit_code == 0
+    assert result.output == ""
+
+
+def test_list_prints_recursive_relative_files() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("root.txt", "w", encoding="utf-8") as file:
+            file.write("root")
+        import os
+
+        os.mkdir("docs")
+        with open("docs/readme.md", "w", encoding="utf-8") as file:
+            file.write("docs")
+
+        result = invoke(runner, "list", ".")
+
+    assert result.exit_code == 0
+    assert result.output.splitlines() == ["docs/readme.md", "root.txt"]
+
+
+def test_tag_and_search_by_tag() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as file:
+            file.write("notes")
+
+        tag_result = invoke(runner, "tag", "README.md", "draft")
+        search_result = invoke(runner, "search-by-tag", ".", "draft")
+
+    assert tag_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output == "README.md\n"
+
+
+def test_duplicate_tag_is_noop() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as file:
+            file.write("notes")
+
+        first = invoke(runner, "tag", "README.md", "draft")
+        second = invoke(runner, "tag", "README.md", "draft")
+        search_result = invoke(runner, "search-by-tag", ".", "draft")
+
+    assert first.exit_code == 0
+    assert second.exit_code == 0
+    assert search_result.output == "README.md\n"
+
+
+def test_move_preserves_tags() -> None:
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        with open("README.md", "w", encoding="utf-8") as file:
+            file.write("notes")
+
+        tag_result = invoke(runner, "tag", "README.md", "draft")
+        move_result = invoke(runner, "move", "README.md", "NOTES.md")
+        search_result = invoke(runner, "search-by-tag", ".", "draft")
+
+    assert tag_result.exit_code == 0
+    assert move_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output == "NOTES.md\n"
+
+
+def test_help_shows_all_subcommands() -> None:
+    runner = CliRunner()
+    result = invoke(runner, "--help")
+
+    assert result.exit_code == 0
+    for command in ("list", "move", "tag", "search-by-tag"):
+        assert command in result.output

