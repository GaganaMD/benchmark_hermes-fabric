@@ -0,0 +1,62 @@
+"""Click entry point for fm."""
+
+from __future__ import annotations
+
+import sys
+from collections.abc import Callable
+
+import click
+
+from . import ops
+
+
+@click.group()
+def cli() -> None:
+    """Manage files and simple tags."""
+
+
+@cli.command("list")
+@click.argument("root", type=click.Path(path_type=str))
+def list_command(root: str) -> None:
+    """Print files under ROOT."""
+    _run(lambda: ops.list_files(root))
+
+
+@cli.command("move")
+@click.argument("src", type=click.Path(path_type=str))
+@click.argument("dst", type=click.Path(path_type=str))
+def move_command(src: str, dst: str) -> None:
+    """Move SRC to DST and preserve tags."""
+    _run(lambda: ops.move_file(src, dst), prints=False)
+
+
+@cli.command("tag")
+@click.argument("path", type=click.Path(path_type=str))
+@click.argument("tag")
+def tag_command(path: str, tag: str) -> None:
+    """Add TAG to PATH."""
+    _run(lambda: ops.add_tag(path, tag), prints=False)
+
+
+@cli.command("search-by-tag")
+@click.argument("root", type=click.Path(path_type=str))
+@click.argument("tag")
+def search_by_tag_command(root: str, tag: str) -> None:
+    """Print files under ROOT with TAG."""
+    _run(lambda: ops.search_by_tag(root, tag))
+
+
+def _run(action: Callable[[], list[str] | None], *, prints: bool = True) -> None:
+    try:
+        result = action()
+    except (FileNotFoundError, NotADirectoryError, ValueError, OSError) as exc:
+        click.echo(str(exc), err=True)
+        sys.exit(1)
+
+    if prints and result:
+        click.echo("\n".join(result))
+
+
+if __name__ == "__main__":
+    cli()
+
