@@ -0,0 +1,47 @@
+"""SQLite storage for file tags."""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+
+DB_NAME = ".fm.db"
+
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+def connect(root: Path, *, create: bool = False) -> sqlite3.Connection | None:
+    database = db_path(root)
+    if not create and not database.exists():
+        return None
+
+    conn = sqlite3.connect(database)
+    conn.execute("PRAGMA foreign_keys = ON")
+    if create:
+        conn.executescript(SCHEMA)
+    return conn
+
+
+def ensure_file(conn: sqlite3.Connection, rel_path: str) -> int:
+    conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (rel_path,))
+    row = conn.execute("SELECT id FROM files WHERE path = ?", (rel_path,)).fetchone()
+    if row is None:
+        raise RuntimeError(f"failed to create file record for {rel_path}")
+    return int(row[0])
+
