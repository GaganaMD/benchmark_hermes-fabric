+"""Filesystem and tag operations for the fm CLI."""
+
+from __future__ import annotations
+
+import os
+import shutil
+from pathlib import Path
+
+from . import db
+
+
+def resolve_root(root: str | Path) -> Path:
+    return Path(root).expanduser().resolve()
+
+
+def _display_path(path: Path, root: Path) -> str:
+    return path.relative_to(root).as_posix()
+
+
+def _cli_path_root(path: Path) -> Path:
+    if path.is_absolute():
+        return path.parent.resolve()
+    return Path.cwd().resolve()
+
+
+def _relative_to_root(path: Path, root: Path) -> str:
+    full_path = path.expanduser().resolve() if path.is_absolute() else (Path.cwd() / path).resolve()
+    return full_path.relative_to(root).as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    root_path = resolve_root(root)
+    if not root_path.exists():
+        raise FileNotFoundError(f"root does not exist: {root}")
+    if not root_path.is_dir():
+        raise NotADirectoryError(f"root is not a directory: {root}")
+
+    files = [
+        _display_path(path, root_path)
+        for path in root_path.rglob("*")
+        if path.is_file() and path.name != db.DB_NAME
+    ]
+    return sorted(files)
+
+
+def add_tag(path: str | Path, tag: str) -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+
+    path_obj = Path(path).expanduser()
+    root = _cli_path_root(path_obj)
+    rel_path = _relative_to_root(path_obj, root)
+    full_path = root / rel_path
+    if not full_path.is_file():
+        raise FileNotFoundError(f"file does not exist: {path}")
+
+    conn = db.connect(root, create=True)
+    assert conn is not None
+    with conn:
+        file_id = db.ensure_file(conn, rel_path)
+        conn.execute(
+            "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+            (file_id, tag),
+        )
+    conn.close()
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    root_path = resolve_root(root)
+    conn = db.connect(root_path, create=False)
+    if conn is None:
+        return []
+
+    rows = conn.execute(
+        """
+        SELECT files.path
+        FROM files
+        JOIN tags ON files.id = tags.file_id
+        WHERE tags.tag = ?
+        ORDER BY files.path
+        """,
+        (tag,),
+    ).fetchall()
+    conn.close()
+
+    return [
+        rel_path
+        for (rel_path,) in rows
+        if (root_path / rel_path).is_file()
+    ]
+
+
+def move_file(src: str | Path, dst: str | Path) -> None:
+    src_path = Path(src).expanduser()
+    dst_path = Path(dst).expanduser()
+    root = _cli_path_root(src_path)
+    src_rel = _relative_to_root(src_path, root)
+    dst_rel = _relative_to_root(dst_path, root)
+    full_src = root / src_rel
+    full_dst = root / dst_rel
+
+    if not full_src.is_file():
+        raise FileNotFoundError(f"source file does not exist: {src}")
+    if not full_dst.parent.exists():
+        raise FileNotFoundError(f"destination directory does not exist: {full_dst.parent}")
+
+    conn = db.connect(root, create=False)
+    try:
+        if conn is not None:
+            conn.execute("BEGIN IMMEDIATE")
+            conn.execute("UPDATE files SET path = ? WHERE path = ?", (dst_rel, src_rel))
+        try:
+            os.replace(full_src, full_dst)
+        except OSError:
+            if conn is not None:
+                conn.rollback()
+            raise
+        if conn is not None:
+            conn.commit()
+    finally:
+        if conn is not None:
+            conn.close()
+
