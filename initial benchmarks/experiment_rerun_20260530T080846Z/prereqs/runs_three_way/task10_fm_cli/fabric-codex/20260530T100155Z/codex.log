+    try:
+        if conn is not None:
+            conn.execute("BEGIN IMMEDIATE")
+            conn.execute("UPDATE files SET path = ? WHERE path = ?", (dst_rel, src_rel))
+        try:
+            os.replace(full_src, full_dst)
+        except OSError:
+            if conn is not None:
+                conn.rollback()
+            raise
+        if conn is not None:
+            conn.commit()
+    finally:
+        if conn is not None:
+            conn.close()
+
