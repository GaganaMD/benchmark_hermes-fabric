diff --git a/src/cli.py b/src/cli.py
index 5ca276b..f7ec280 100644
--- a/src/cli.py
+++ b/src/cli.py
@@ -3,24 +3,40 @@ import click
 from pathlib import Path
 
 @click.group()
-def cli():
-    pass
+@click.option("--dry-run", is_flag=True, help="Print actions without writing files.")
+@click.pass_context
+def cli(ctx, dry_run):
+    """Simple file-touching CLI.
+
+    The --dry-run flag is accepted at the group level and applies to all
+    subcommands, skipping filesystem mutations.
+    """
+    ctx.ensure_object(dict)
+    ctx.obj["dry_run"] = dry_run
 
 @cli.command()
 @click.argument("name")
 @click.option("--content", default="hello\n")
-def write(name, content):
+@click.pass_context
+def write(ctx, name, content):
     """Write CONTENT to a file named NAME."""
+    if ctx.obj.get("dry_run"):
+        click.echo(f"would write {name}")
+        return
     Path(name).write_text(content)
     click.echo(f"wrote {name}")
 
 @cli.command()
 @click.argument("name")
 @click.option("--suffix", default=".bak")
-def rename(name, suffix):
+@click.pass_context
+def rename(ctx, name, suffix):
     """Rename NAME to NAME+SUFFIX."""
     src = Path(name)
     dst = src.with_suffix(src.suffix + suffix)
+    if ctx.obj.get("dry_run"):
+        click.echo(f"would rename {name} -> {dst}")
+        return
     src.rename(dst)
     click.echo(f"renamed {name} -> {dst}")
 
diff --git a/tests/test_cli.py b/tests/test_cli.py
