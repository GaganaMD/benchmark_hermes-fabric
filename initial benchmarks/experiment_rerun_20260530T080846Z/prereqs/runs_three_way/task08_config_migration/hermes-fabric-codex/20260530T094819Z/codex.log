+def load_config(path: str | None = None) -> dict:
+    """Load configuration from TOML, with INI as a deprecated fallback.
+
+    By default, prefer ``config.toml`` in the current directory. If it is not
+    present, load ``config.ini`` for one release and emit a DeprecationWarning.
+    An explicit path loads that file directly, warning when the file is INI.
+    """
+    if path is None:
+        toml_path = Path("config.toml")
+        if toml_path.exists():
+            return _load_toml(toml_path)
+
+        ini_path = Path("config.ini")
+        if ini_path.exists():
+            warnings.warn(
+                "config.ini is deprecated; migrate configuration to config.toml",
+                DeprecationWarning,
+                stacklevel=2,
+            )
+            return _load_ini(ini_path)
+
+        raise FileNotFoundError("config.toml")
+
+    config_path = Path(path)
+    if not config_path.exists():
+        raise FileNotFoundError(path)
+
+    if config_path.suffix.lower() == ".toml":
+        return _load_toml(config_path)
+
+    warnings.warn(
