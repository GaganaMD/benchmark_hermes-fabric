@@ -0,0 +1,72 @@
+"""SQLite storage for fm tags."""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+DB_NAME = ".fm.db"
+
+SCHEMA = """
+PRAGMA foreign_keys = ON;
+CREATE TABLE IF NOT EXISTS files (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    path TEXT UNIQUE NOT NULL
+);
+CREATE TABLE IF NOT EXISTS tags (
+    file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+    tag TEXT NOT NULL,
+    PRIMARY KEY (file_id, tag)
+);
+"""
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+def connect(root: Path) -> sqlite3.Connection:
+    root.mkdir(parents=True, exist_ok=True)
+    conn = sqlite3.connect(db_path(root))
+    conn.execute("PRAGMA foreign_keys = ON")
+    conn.executescript(SCHEMA)
+    return conn
+
+
+def add_tag(root: Path, rel_path: str, tag: str) -> None:
+    with connect(root) as conn:
+        cur = conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (rel_path,))
+        if cur.lastrowid:
+            file_id = cur.lastrowid
+        else:
+            row = conn.execute("SELECT id FROM files WHERE path = ?", (rel_path,)).fetchone()
+            file_id = row[0]
+        conn.execute(
+            "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+            (file_id, tag),
+        )
+
+
+def tagged_paths(root: Path, tag: str) -> list[str]:
+    path = db_path(root)
+    if not path.exists():
+        return []
+    with connect(root) as conn:
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    return [row[0] for row in rows]
+
+
+def update_path(root: Path, old_rel_path: str, new_rel_path: str, conn: sqlite3.Connection) -> None:
+    conn.execute(
+        "UPDATE files SET path = ? WHERE path = ?",
+        (new_rel_path, old_rel_path),
+    )
