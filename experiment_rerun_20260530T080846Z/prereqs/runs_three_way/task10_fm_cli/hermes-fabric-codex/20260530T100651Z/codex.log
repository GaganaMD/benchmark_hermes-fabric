+"""File-management operations for fm."""
+
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+from . import db
+
+
+def normalize_root(root: str | Path) -> Path:
+    return Path(root).expanduser().resolve()
+
+
+def relative_to_root(path: str | Path, root: Path) -> str:
+    return Path(path).expanduser().resolve().relative_to(root).as_posix()
+
+
+def managed_root_for_file(path: str | Path) -> Path:
+    return Path(path).expanduser().resolve().parent
+
+
+def list_files(root: str | Path) -> list[str]:
+    root_path = normalize_root(root)
+    if not root_path.exists():
+        raise FileNotFoundError(root_path)
+    if not root_path.is_dir():
+        raise NotADirectoryError(root_path)
+
+    files: list[str] = []
+    for path in root_path.rglob("*"):
+        if path.is_file() and path.name != db.DB_NAME:
+            files.append(path.relative_to(root_path).as_posix())
+    return sorted(files)
+
+
+def tag_file(path: str | Path, tag: str) -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+    file_path = Path(path).expanduser().resolve()
+    if not file_path.is_file():
+        raise FileNotFoundError(file_path)
+    root = file_path.parent
+    db.add_tag(root, file_path.relative_to(root).as_posix(), tag)
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    root_path = normalize_root(root)
+    paths = []
+    for rel_path in db.tagged_paths(root_path, tag):
+        if (root_path / rel_path).is_file():
+            paths.append(rel_path)
+    return paths
+
+
+def move_file(src: str | Path, dst: str | Path) -> None:
+    src_path = Path(src).expanduser().resolve()
+    dst_path = Path(dst).expanduser().resolve()
+    if not src_path.is_file():
+        raise FileNotFoundError(src_path)
+    if dst_path.exists():
+        raise FileExistsError(dst_path)
+
+    root = src_path.parent
+    old_rel = src_path.relative_to(root).as_posix()
+    try:
+        new_rel = dst_path.relative_to(root).as_posix()
+    except ValueError as exc:
+        raise ValueError("destination must be inside the managed root") from exc
+
+    dst_path.parent.mkdir(parents=True, exist_ok=True)
+    with db.connect(root) as conn:
+        db.update_path(root, old_rel, new_rel, conn)
+        shutil.move(str(src_path), str(dst_path))
