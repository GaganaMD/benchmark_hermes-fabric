+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+from click.testing import CliRunner
+
+from tools.fm.cli import cli
+
+
+def invoke(runner: CliRunner, args: list[str], cwd: Path):
+    return runner.invoke(cli, args, catch_exceptions=False, obj=None, color=False, prog_name="fm", env={}, input=None, terminal_width=80, standalone_mode=True, mix_stderr=True, windows_expand_args=True, cwd=str(cwd))
+
+
+def test_list_prints_recursive_files_relative_to_root(tmp_path: Path) -> None:
+    (tmp_path / "a.txt").write_text("a")
+    (tmp_path / "nested").mkdir()
+    (tmp_path / "nested" / "b.txt").write_text("b")
+
+    result = CliRunner().invoke(cli, ["list", str(tmp_path)])
+
+    assert result.exit_code == 0
+    assert result.output.splitlines() == ["a.txt", "nested/b.txt"]
+
+
+def test_list_empty_directory_succeeds(tmp_path: Path) -> None:
+    result = CliRunner().invoke(cli, ["list", str(tmp_path)])
+
+    assert result.exit_code == 0
+    assert result.output == ""
+
+
+def test_tag_and_search_by_tag_round_trip(tmp_path: Path) -> None:
+    runner = CliRunner()
+    (tmp_path / "README.md").write_text("draft")
+
+    tag_result = runner.invoke(cli, ["tag", "README.md", "draft"], cwd=str(tmp_path))
+    search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"], cwd=str(tmp_path))
+
+    assert tag_result.exit_code == 0
+    assert search_result.exit_code == 0
+    assert search_result.output.splitlines() == ["README.md"]
+    assert (tmp_path / ".fm.db").is_file()
+
+
+def test_duplicate_tag_is_noop(tmp_path: Path) -> None:
+    runner = CliRunner()
+    (tmp_path / "README.md").write_text("draft")
+
+    assert runner.invoke(cli, ["tag", "README.md", "draft"], cwd=str(tmp_path)).exit_code == 0
+    assert runner.invoke(cli, ["tag", "README.md", "draft"], cwd=str(tmp_path)).exit_code == 0
+
+    with sqlite3.connect(tmp_path / ".fm.db") as conn:
+        count = conn.execute("SELECT COUNT(*) FROM tags").fetchone()[0]
+    assert count == 1
+
+
+def test_move_preserves_tags(tmp_path: Path) -> None:
+    runner = CliRunner()
+    (tmp_path / "README.md").write_text("draft")
+
+    assert runner.invoke(cli, ["tag", "README.md", "draft"], cwd=str(tmp_path)).exit_code == 0
+    move_result = runner.invoke(cli, ["move", "README.md", "NOTES.md"], cwd=str(tmp_path))
+    search_result = runner.invoke(cli, ["search-by-tag", ".", "draft"], cwd=str(tmp_path))
+
+    assert move_result.exit_code == 0
+    assert not (tmp_path / "README.md").exists()
+    assert (tmp_path / "NOTES.md").read_text() == "draft"
+    assert search_result.exit_code == 0
+    assert search_result.output.splitlines() == ["NOTES.md"]
+
+
+def test_help_shows_all_subcommands() -> None:
+    result = CliRunner().invoke(cli, ["--help"])
+
+    assert result.exit_code == 0
+    for command in ["list", "move", "tag", "search-by-tag"]:
+        assert command in result.output

