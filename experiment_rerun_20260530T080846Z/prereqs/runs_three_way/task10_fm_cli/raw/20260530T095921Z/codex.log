+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+
+DB_NAME = ".fm.db"
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+def connect(root: Path) -> sqlite3.Connection:
+    conn = sqlite3.connect(db_path(root))
+    conn.execute("PRAGMA foreign_keys = ON")
+    return conn
+
+
+def init(conn: sqlite3.Connection) -> None:
+    conn.executescript(
+        """
+        CREATE TABLE IF NOT EXISTS files (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            path TEXT UNIQUE NOT NULL
+        );
+        CREATE TABLE IF NOT EXISTS tags (
+            file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+            tag TEXT NOT NULL,
+            PRIMARY KEY (file_id, tag)
+        );
+        """
+    )
+
+
+@contextmanager
+def transaction(root: Path) -> Iterator[sqlite3.Connection]:
+    conn = connect(root)
+    try:
+        init(conn)
+        conn.execute("BEGIN")
+        yield conn
+    except Exception:
+        conn.rollback()
+        raise
+    else:
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def add_tag(conn: sqlite3.Connection, rel_path: str, tag: str) -> None:
+    conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (rel_path,))
+    file_id = conn.execute("SELECT id FROM files WHERE path = ?", (rel_path,)).fetchone()[0]
+    conn.execute(
+        "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+        (file_id, tag),
+    )
+
+
+def move_tags(conn: sqlite3.Connection, old_rel_path: str, new_rel_path: str) -> None:
+    existing = conn.execute("SELECT id FROM files WHERE path = ?", (old_rel_path,)).fetchone()
+    if existing is None:
+        return
+
+    conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (new_rel_path,))
+    new_file_id = conn.execute("SELECT id FROM files WHERE path = ?", (new_rel_path,)).fetchone()[0]
+    old_file_id = existing[0]
+    conn.execute(
+        """
+        INSERT OR IGNORE INTO tags(file_id, tag)
+        SELECT ?, tag FROM tags WHERE file_id = ?
+        """,
+        (new_file_id, old_file_id),
+    )
+    conn.execute("DELETE FROM files WHERE id = ?", (old_file_id,))
+
+
+def tagged_paths(root: Path, tag: str) -> list[str]:
+    if not db_path(root).exists():
+        return []
+
+    with connect(root) as conn:
+        init(conn)
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    return [row[0] for row in rows]
+
