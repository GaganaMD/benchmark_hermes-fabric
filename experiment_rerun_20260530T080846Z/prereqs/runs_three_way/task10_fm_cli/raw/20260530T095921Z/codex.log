diff --git a/tools/fm/cli.py b/tools/fm/cli.py
new file mode 100644
index 0000000000000000000000000000000000000000..e1873e14c50196f832270983e5b137ecc9368838
--- /dev/null
+++ b/tools/fm/cli.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import sys
+
+import click
+
+from . import ops
+
+
+@click.group(context_settings={"help_option_names": ["-h", "--help"]})
+def cli() -> None:
+    """Manage files and tags under a local root."""
+
+
+@cli.command("list")
+@click.argument("root", type=click.Path(path_type=str))
+def list_command(root: str) -> None:
+    """Print files under ROOT."""
+    for rel_path in ops.list_files(root):
+        click.echo(rel_path)
+
+
+@cli.command("move")
+@click.argument("src", type=click.Path(path_type=str))
+@click.argument("dst", type=click.Path(path_type=str))
+def move_command(src: str, dst: str) -> None:
+    """Move SRC to DST and preserve tags."""
+    ops.move_file(src, dst)
+
+
+@cli.command("tag")
+@click.argument("path", type=click.Path(path_type=str))
+@click.argument("tag")
+def tag_command(path: str, tag: str) -> None:
+    """Attach TAG to PATH."""
+    ops.tag_file(path, tag)
+
+
+@cli.command("search-by-tag")
+@click.argument("root", type=click.Path(path_type=str))
+@click.argument("tag")
+def search_by_tag_command(root: str, tag: str) -> None:
+    """Print files under ROOT that have TAG."""
+    for rel_path in ops.search_by_tag(root, tag):
+        click.echo(rel_path)
+
+
+def main() -> None:
+    try:
+        cli()
+    except (FileNotFoundError, FileExistsError, NotADirectoryError, ValueError) as exc:
+        click.echo(f"fm: {exc}", err=True)
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
+
diff --git a/tools/fm/db.py b/tools/fm/db.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc04e2f94ad7c89d05498a2d35d9025abfa5d21c
--- /dev/null
+++ b/tools/fm/db.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Iterator
+
+
+DB_NAME = ".fm.db"
+
+
+def db_path(root: Path) -> Path:
+    return root / DB_NAME
+
+
+def connect(root: Path) -> sqlite3.Connection:
+    conn = sqlite3.connect(db_path(root))
+    conn.execute("PRAGMA foreign_keys = ON")
+    return conn
+
+
+def init(conn: sqlite3.Connection) -> None:
+    conn.executescript(
+        """
+        CREATE TABLE IF NOT EXISTS files (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            path TEXT UNIQUE NOT NULL
+        );
+        CREATE TABLE IF NOT EXISTS tags (
+            file_id INTEGER NOT NULL REFERENCES files(id) ON DELETE CASCADE,
+            tag TEXT NOT NULL,
+            PRIMARY KEY (file_id, tag)
+        );
+        """
+    )
+
+
+@contextmanager
+def transaction(root: Path) -> Iterator[sqlite3.Connection]:
+    conn = connect(root)
+    try:
+        init(conn)
+        conn.execute("BEGIN")
+        yield conn
+    except Exception:
+        conn.rollback()
+        raise
+    else:
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def add_tag(conn: sqlite3.Connection, rel_path: str, tag: str) -> None:
+    conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (rel_path,))
+    file_id = conn.execute("SELECT id FROM files WHERE path = ?", (rel_path,)).fetchone()[0]
+    conn.execute(
+        "INSERT OR IGNORE INTO tags(file_id, tag) VALUES (?, ?)",
+        (file_id, tag),
+    )
+
+
+def move_tags(conn: sqlite3.Connection, old_rel_path: str, new_rel_path: str) -> None:
+    existing = conn.execute("SELECT id FROM files WHERE path = ?", (old_rel_path,)).fetchone()
+    if existing is None:
+        return
+
+    conn.execute("INSERT OR IGNORE INTO files(path) VALUES (?)", (new_rel_path,))
+    new_file_id = conn.execute("SELECT id FROM files WHERE path = ?", (new_rel_path,)).fetchone()[0]
+    old_file_id = existing[0]
+    conn.execute(
+        """
+        INSERT OR IGNORE INTO tags(file_id, tag)
+        SELECT ?, tag FROM tags WHERE file_id = ?
+        """,
+        (new_file_id, old_file_id),
+    )
+    conn.execute("DELETE FROM files WHERE id = ?", (old_file_id,))
+
+
+def tagged_paths(root: Path, tag: str) -> list[str]:
+    if not db_path(root).exists():
+        return []
+
+    with connect(root) as conn:
+        init(conn)
+        rows = conn.execute(
+            """
+            SELECT files.path
+            FROM files
+            JOIN tags ON tags.file_id = files.id
+            WHERE tags.tag = ?
+            ORDER BY files.path
+            """,
+            (tag,),
+        ).fetchall()
+    return [row[0] for row in rows]
+
diff --git a/tools/fm/ops.py b/tools/fm/ops.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9a487ef5fbea2ed4e8bab5674d19cb3bda0f525
--- /dev/null
+++ b/tools/fm/ops.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+from . import db
+
+
+def normalize_root(root: str | Path) -> Path:
+    return Path(root).expanduser().resolve()
+
+
+def relative_to_root(path: str | Path, root: Path) -> str:
+    resolved = Path(path).expanduser().resolve()
+    try:
+        rel_path = resolved.relative_to(root)
+    except ValueError as exc:
+        raise ValueError(f"{path} is outside managed root {root}") from exc
+    return rel_path.as_posix()
+
+
+def list_files(root: str | Path) -> list[str]:
+    root_path = normalize_root(root)
+    if not root_path.exists():
+        raise FileNotFoundError(root_path)
+    if not root_path.is_dir():
+        raise NotADirectoryError(root_path)
+
+    files: list[str] = []
+    for current_root, dirnames, filenames in os.walk(root_path):
+        dirnames[:] = [dirname for dirname in dirnames if dirname != "__pycache__"]
+        base = Path(current_root)
+        for filename in filenames:
+            if filename == db.DB_NAME:
+                continue
+            files.append((base / filename).relative_to(root_path).as_posix())
+    return sorted(files)
+
+
+def tag_file(path: str | Path, tag: str, root: str | Path = ".") -> None:
+    if not tag:
+        raise ValueError("tag must be a non-empty string")
+
+    root_path = normalize_root(root)
+    rel_path = relative_to_root(path, root_path)
+    file_path = root_path / rel_path
+    if not file_path.is_file():
+        raise FileNotFoundError(file_path)
+
+    with db.transaction(root_path) as conn:
+        db.add_tag(conn, rel_path, tag)
+
+
+def move_file(src: str | Path, dst: str | Path, root: str | Path = ".") -> None:
+    root_path = normalize_root(root)
+    old_rel_path = relative_to_root(src, root_path)
+    new_rel_path = relative_to_root(dst, root_path)
+    src_path = root_path / old_rel_path
+    dst_path = root_path / new_rel_path
+
+    if not src_path.is_file():
+        raise FileNotFoundError(src_path)
+    if dst_path.exists():
+        raise FileExistsError(dst_path)
+
+    dst_path.parent.mkdir(parents=True, exist_ok=True)
+    moved = False
+    try:
+        with db.transaction(root_path) as conn:
+            os.replace(src_path, dst_path)
+            moved = True
+            db.move_tags(conn, old_rel_path, new_rel_path)
+    except Exception:
+        if moved and dst_path.exists() and not src_path.exists():
+            os.replace(dst_path, src_path)
+        raise
+
+
+def search_by_tag(root: str | Path, tag: str) -> list[str]:
+    root_path = normalize_root(root)
+    if not root_path.exists():
+        raise FileNotFoundError(root_path)
+    if not root_path.is_dir():
+        raise NotADirectoryError(root_path)
+
+    matches = []
+    for rel_path in db.tagged_paths(root_path, tag):
+        if (root_path / rel_path).is_file():
+            matches.append(rel_path)
+    return matches
+
